    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.6.1",
    "firebase": "^11.0.2",
    "firebase-admin": "^13.7.0",
    "framer-motion": "^12.38.0",
    "jose": "^6.2.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "leaflet": "^1.9.4",
    "mongoose": "^8.5.2",
    "next": "^16.2.1",
    "next-auth": "^4.24.13",
    "nodemailer": "^8.0.4",
    "react": "^18",
    "react-csv": "^2.2.2",
    "react-dom": "^18",
    "react-leaflet": "^4.2.1",
    "recharts": "^2.15.1",
    "redis": "^5.11.0",
    "styled-components": "^6.1.11",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^0.3.1",
    "use-places-autocomplete": "^4.0.1",
    "uuid": "^11.1.0",
    "vercel": "^32.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/forms": "^0.5.11",
    "@types/bcryptjs": "^2.4.6",
    "@types/crypto-js": "^4.2.2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.19.37",
    "@types/nodemailer": "^6.4.23",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "bcrypt": "^5.1.1",
    "eslint": "^9",
    "eslint-config-next": "^16.2.1",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
