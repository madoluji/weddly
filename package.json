{
  "name": "weddly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "/opt/homebrew/opt/node@22/bin/node scripts/dev-safe.mjs",
    "dev:stack": "zsh scripts/dev-stack.sh",
    "dev:restart": "/opt/homebrew/opt/node@22/bin/node scripts/dev-safe.mjs --fresh",
    "dev:app": "next dev --webpack",
    "dev:22": "/opt/homebrew/opt/node@22/bin/npm run dev:app",
    "build": "/opt/homebrew/opt/node@22/bin/node scripts/build-safe.mjs",
    "build:app": "next build",
    "build:raw": "next build",
    "build:safe": "/opt/homebrew/opt/node@22/bin/node scripts/build-safe.mjs",
    "build:stable": "NEXT_BUILD_CPUS=4 BUILD_MAX_OLD_SPACE_MB=3072 /opt/homebrew/opt/node@22/bin/node scripts/build-safe.mjs",
    "start": "next start",
    "lint": "eslint .",
    "clean": "next clean",
    "test": "tsx --test tests/**/*.test.ts",
    "test:filters": "tsx --test tests/job-filters.test.ts",
    "test:flow": "tsx --test tests/find-job-flow.test.ts",
    "migrate:notifications:sender-names": "tsx scripts/migrate-notification-sender-names.ts",
    "migrate:notifications:sender-names:dry": "tsx scripts/migrate-notification-sender-names.ts --dry-run",
    "seed:superadmin": "tsx scripts/seed-superadmin.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@paypal/react-paypal-js": "^8.8.2",
